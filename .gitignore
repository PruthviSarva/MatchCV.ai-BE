target/
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# Secrets. Everything .env* is ignored — including ad-hoc copies like
# .env.local or .env.bak, which a bare `.env` rule would have let through —
# and .env.example is re-included because it holds only placeholders.
.env
.env.*
!.env.example

