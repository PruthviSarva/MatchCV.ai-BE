# Copy to .env and fill in. .env is gitignored; this file is not.

# --- Database (Neon) -------------------------------------------------------
# Take these from the Neon dashboard. The JDBC URL is the psql host with
# "jdbc:postgresql://" in front and the query string kept.
#
# Named DB_URL, not DATABASE_URL, on purpose: several hosts inject their own
# DATABASE_URL in libpq form (postgres://user:pass@host/db), which Spring
# cannot use as a JDBC URL. A distinct name cannot be clobbered by them.
DB_URL=jdbc:postgresql://<host>.neon.tech/neondb?sslmode=require&channel_binding=require
DATABASE_USERNAME=neondb_owner
DATABASE_PASSWORD=

# --- Auth ------------------------------------------------------------------
# Must decode to at least 32 bytes for HS256. Generate with:
#   openssl rand -base64 48
# Boot fails if this is unset — that is deliberate.
JWT_SECRET=

# --- Claude ----------------------------------------------------------------
# From https://console.anthropic.com. If left blank the app still boots, and
# tailoring requests return a clear "not configured" error.
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-opus-5

# --- Optional --------------------------------------------------------------
SERVER_PORT=8091
# Comma-separated. Defaults to localhost only; set the real origin in production.
CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:3000
QUOTA_FREE_MONTHLY=3
QUOTA_PRO_MONTHLY=200
ADMIN_EMAIL=admin@matchcv.ai
# Blank or absent turns bootstrap-admin seeding off entirely.
ADMIN_PASSWORD=
ADMIN_NAME=MatchCV Admin
