# Copy to .env and fill in. .env is gitignored; this file is not.

# --- Database (Neon) -------------------------------------------------------
# Take these from the Neon dashboard.
#
# This must be a *JDBC* URL: "jdbc:postgresql://host/db?...". Neon's dashboard
# shows the libpq form ("postgresql://user:pass@host/db"), and managed-database
# add-ons (Render's own Postgres, Heroku) inject that form too — Spring cannot
# use it as a JDBC URL. Keep the host and the query string, put
# "jdbc:postgresql://" in front, and pass the user and password separately.
DATABASE_URL=jdbc:postgresql://<host>.neon.tech/neondb?sslmode=require&channel_binding=require
DATABASE_USERNAME=neondb_owner
DATABASE_PASSWORD=

# --- Auth ------------------------------------------------------------------
# Must decode to at least 32 bytes for HS256. Generate with:
#   openssl rand -base64 48
# Boot fails if this is unset — that is deliberate.
JWT_SECRET=

# --- Claude ----------------------------------------------------------------
# From https://console.anthropic.com. If left blank the app still boots, and
# tailoring requests return a clear "not configured" error.
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-opus-5

# --- Optional --------------------------------------------------------------
# Local listener only. Deployments (Render, Fly, Cloud Run) inject PORT, and
# that takes precedence — see server.port in application.yml.
SERVER_PORT=8091
# Comma-separated. Defaults to localhost only; set the real origin in
# production, e.g. https://matchcv.ai,https://*.vercel.app
CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:3000
QUOTA_FREE_MONTHLY=3
QUOTA_PRO_MONTHLY=200
ADMIN_EMAIL=admin@matchcv.ai
# Blank or absent turns bootstrap-admin seeding off entirely.
ADMIN_PASSWORD=
ADMIN_NAME=MatchCV Admin
